#version 450
#extension GL_GOOGLE_include_directive : require
// IQ4_NL, 18 bytes per 32 values: f16 d, 16 nibble bytes; each nibble
// indexes ggml's kvalues_iq4nl; low nibble is element i, high nibble
// element i+16 (frink_quant::dot_iq4_nl_f32_scalar). One unit per block.
#include "matvec_common.glsl"
#include "iq4_values.glsl"

void main() {
    uint row = matvec_row();
    if (row >= p.rows) return;
    uint base = row * p.row_bytes;
    float acc = 0.0;
    for (uint b = gl_LocalInvocationID.x; b < p.n_blocks_per_row; b += WG) {
        uint blk = base + b * 18u;
        uint xb = b * 32u;
        float s = 0.0;
        for (uint i = 0u; i < 16u; ++i) {
            uint q = byte_at(blk + 2u + i);
            s += kvalue_iq4nl(q & 0x0fu) * X(xb + i);
            s += kvalue_iq4nl(q >> 4) * X(xb + 16u + i);
        }
        acc += f16_at(blk) * s;
    }
    finish(row, acc);
}
