#version 450
#extension GL_GOOGLE_include_directive : require
// Q5_K, 176 bytes per 256 values: Q4_K's d, dmin and scales, then 32
// high-bit bytes and 128 nibble bytes; the high bit of sub-block j is
// bit j of qh[l] (frink_quant::dequant_q5_k). Units as in Q4_K.
#include "matvec_common.glsl"

void main() {
    uint row = matvec_row();
    if (row >= p.rows) return;
    uint base = row * p.row_bytes;
    float acc = 0.0;
    for (uint u = gl_LocalInvocationID.x; u < p.n_blocks_per_row * 8u; u += WG) {
        uint b = u >> 3, j = u & 7u, c = j >> 1, shift = (j & 1u) * 4u;
        uint blk = base + b * 176u;
        float sc, m;
        scale_min_k4(j, blk + 4u, sc, m);
        uint qh = blk + 16u;
        uint qs = blk + 48u + c * 32u;
        uint xb = b * 256u + j * 32u;
        float s = 0.0, xs = 0.0;
        // 176 is a word multiple, so qs and qh are word-aligned: read a
        // word of each and take its four bytes at constant shifts.
        for (uint l = 0u; l < 32u; l += 4u) {
            uint lo = w[(qs + l) >> 2] >> shift;
            uint hi = w[(qh + l) >> 2] >> j;
            for (uint k = 0u; k < 4u; ++k) {
                float xv = x[xb + l + k];
                uint q = ((lo >> (8u * k)) & 0x0fu) | (((hi >> (8u * k)) & 1u) << 4);
                s += float(q) * xv;
                xs += xv;
            }
        }
        acc += f16_at(blk) * sc * s - f16_at(blk + 2u) * m * xs;
    }
    finish(row, acc);
}
