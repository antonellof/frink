#version 450
#extension GL_GOOGLE_include_directive : require
// Q4_K, 144 bytes per 256 values: f16 d, f16 dmin, 12 packed scale
// bytes, 128 nibble bytes (frink_quant::dequant_q4_k).
#include "matvec_common.glsl"

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= p.rows) return;
    uint base = row * p.row_bytes;
    float acc = 0.0;
    for (uint b = 0u; b < p.n_blocks_per_row; ++b) {
        uint blk = base + b * 144u;
        float d = f16_at(blk);
        float dmin = f16_at(blk + 2u);
        uint qs = blk + 16u;
        uint xb = b * 256u;
        for (uint c = 0u; c < 4u; ++c) {
            float sc1, m1, sc2, m2;
            scale_min_k4(2u * c, blk + 4u, sc1, m1);
            scale_min_k4(2u * c + 1u, blk + 4u, sc2, m2);
            float d1 = d * sc1, min1 = dmin * m1;
            float d2 = d * sc2, min2 = dmin * m2;
            for (uint l = 0u; l < 32u; ++l) {
                uint q = byte_at(qs + c * 32u + l);
                acc += (d1 * float(q & 0x0fu) - min1) * x[xb + c * 64u + l];
                acc += (d2 * float(q >> 4) - min2) * x[xb + c * 64u + 32u + l];
            }
        }
    }
    y[row] = acc;
}
