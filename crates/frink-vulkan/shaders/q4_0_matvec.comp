#version 450
#extension GL_GOOGLE_include_directive : require
// Q4_0, 18 bytes per 32 values: f16 d, then 16 bytes whose low nibbles
// are values 0..16 and high nibbles 16..32, each (nibble - 8) * d
// (frink_quant::dequant_q4_0).
#include "matvec_common.glsl"

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= p.rows) return;
    uint base = row * p.row_bytes;
    float acc = 0.0;
    for (uint b = 0u; b < p.n_blocks_per_row; ++b) {
        uint blk = base + b * 18u;
        float d = f16_at(blk);
        uint xb = b * 32u;
        float s = 0.0;
        for (uint i = 0u; i < 16u; ++i) {
            uint q = byte_at(blk + 2u + i);
            s += float(int(q & 0x0fu) - 8) * x[xb + i];
            s += float(int(q >> 4) - 8) * x[xb + 16u + i];
        }
        acc += d * s;
    }
    y[row] = acc;
}
