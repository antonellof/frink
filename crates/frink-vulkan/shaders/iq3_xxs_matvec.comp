#version 450
#extension GL_GOOGLE_include_directive : require
// IQ3_XXS, 98 bytes per 256 values: f16 d, 64 grid index bytes, then
// eight words of four 7-bit sign codes and a 4-bit scale
// (frink_quant::dot_iq3_xxs_f32_scalar).
#define IQ_BLOCK_BYTES 98u
#include "iq_common.glsl"

float sub_dot(uint blk, uint il, uint xb) {
    uint ib32 = il >> 1;
    uint aux32 = u32_at(blk + 66u + 4u * ib32);
    float db = f16_at(blk) * (0.5 + float(aux32 >> 28)) * 0.5;
    float s = 0.0;
    for (uint k = 0u; k < 2u; ++k) {
        uint l = 2u * (il & 1u) + k;
        uint q = blk + 2u + 8u * ib32 + 2u * l;
        s += grid8_dot(db, iq_tab[IQ_GRID_IQ3XXS + byte_at(q)],
                       iq_tab[IQ_GRID_IQ3XXS + byte_at(q + 1u)],
                       ksigns((aux32 >> (7u * l)) & 127u), xb + 8u * k);
    }
    return s;
}
#include "iq_main.glsl"
