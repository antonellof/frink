#version 450
#extension GL_GOOGLE_include_directive : require
// Q5_1, 24 bytes per 32 values: f16 d, f16 m, a 32-bit qh, 16 nibble
// bytes; fifth bits as in Q5_0; value q*d + m
// (frink_quant::dot_q5_1_f32_scalar). One unit per block.
#include "matvec_common.glsl"

void main() {
    uint row = matvec_row();
    if (row >= p.rows) return;
    uint base = row * p.row_bytes;
    float acc = 0.0;
    for (uint b = gl_LocalInvocationID.x; b < p.n_blocks_per_row; b += WG) {
        uint blk = base + b * 24u;
        uint xb = b * 32u;
        float d = f16_at(blk), m = f16_at(blk + 2u);
        uint qh = byte_at(blk + 4u) | (byte_at(blk + 5u) << 8) | (byte_at(blk + 6u) << 16)
            | (byte_at(blk + 7u) << 24);
        for (uint i = 0u; i < 16u; ++i) {
            uint q = byte_at(blk + 8u + i);
            uint lo = (q & 0x0fu) | (((qh >> i) << 4) & 0x10u);
            uint hi = (q >> 4) | ((qh >> (i + 12u)) & 0x10u);
            acc += (float(lo) * d + m) * x[xb + i];
            acc += (float(hi) * d + m) * x[xb + 16u + i];
        }
    }
    finish(row, acc);
}
