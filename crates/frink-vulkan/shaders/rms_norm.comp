#version 450
// RMSNorm over `rows` rows of `n`: out = x * w / sqrt(mean(x^2) + eps)
// (frink_core::matmul::rms_norm; rms_norm_per_head when rows is the head
// count and n the head width, w then shared by every row). One
// workgroup per row; the sum of squares is a shared-memory tree in f32,
// where ggml's CPU loop sums in order in f64 (a GPU deviation, as
// ggml-vulkan's is).
//
// `mode` bit 0 makes it a LayerNorm: the mean is subtracted first and
// the divisor is the variance of the centred values, as ggml_norm
// (frink_models::norm::layer_norm_no_params). Bit 1 leaves the weight
// out (a norm with no parameters). A bias is a separate add.
//
// Bindings: 0 the weight (as uint words; unread under bit 1), 1 x,
// 2 out. Push: n, rows, eps (f32 bits), mode.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer W { uint w[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform Push { uint n; uint rows; uint eps_bits; uint mode; } p;
shared float partial[64];

// Sum this invocation's `acc` over the workgroup; every invocation
// gets the total.
float reduce(float acc) {
    uint tid = gl_LocalInvocationID.x;
    partial[tid] = acc;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1) {
        if (tid < s) partial[tid] += partial[tid + s];
        barrier();
    }
    float total = partial[0];
    barrier();
    return total;
}

void main() {
    uint row = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (row >= p.rows) return;
    uint tid = gl_LocalInvocationID.x, base = row * p.n;
    float mean = 0.0;
    if ((p.mode & 1u) != 0u) {
        float sum = 0.0;
        for (uint i = tid; i < p.n; i += 64u) sum += x[base + i];
        mean = reduce(sum) / float(p.n);
    }
    float acc = 0.0;
    for (uint i = tid; i < p.n; i += 64u) {
        float d = x[base + i] - mean;
        acc += d * d;
    }
    float scale = 1.0 / sqrt(reduce(acc) / float(p.n) + uintBitsToFloat(p.eps_bits));
    bool weighted = (p.mode & 2u) == 0u;
    for (uint i = tid; i < p.n; i += 64u) {
        float v = (x[base + i] - mean) * scale;
        o[base + i] = weighted ? v * uintBitsToFloat(w[i]) : v;
    }
}
