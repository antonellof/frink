#version 450
// out = a + b, the residual add. With a `period`, b is that many
// values and repeats: a bias added to every position's row. Bindings:
// 0 a (as uint words), 1 b, 2 out. Push: n, period (0 for none).
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer A { uint a[]; };
layout(std430, binding = 1) readonly buffer B { float b[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform Push { uint n; uint period; } p;

void main() {
    uint i = gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 64u + gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    o[i] = uintBitsToFloat(a[i]) + b[p.period == 0u ? i : i % p.period];
}
