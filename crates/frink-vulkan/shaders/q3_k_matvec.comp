#version 450
#extension GL_GOOGLE_include_directive : require
// Q3_K, 110 bytes per 256 values: 32 hmask bytes, 64 bytes of 2-bit
// codes, 12 packed 6-bit scales, f16 d (frink_quant::dot_q3_k_f32_scalar).
// Units as in Q2_K. The third bit of value n*128 + j*32 + g*16 + l is
// bit n*4 + j of hmask[g*16 + l]; a clear bit subtracts 4.
#include "matvec_common.glsl"

// ggml's 6-bit Q3_K scale `is` (frink_quant::q3_k_unpack_scales), from
// the 12 bytes at byte offset s.
float q3_k_scale(uint s, uint is) {
    uint k = is & 3u, grp = is >> 2;
    uint lowsrc = byte_at(s + k + (grp & 1u) * 4u);
    uint low = grp < 2u ? (lowsrc & 0x0fu) : (lowsrc >> 4);
    uint high = ((byte_at(s + 8u + k) >> (2u * grp)) & 3u) << 4;
    return float(int(low | high) - 32);
}

void main() {
    uint row = matvec_row();
    if (row >= p.rows) return;
    uint base = row * p.row_bytes;
    float acc = 0.0;
    for (uint u = gl_LocalInvocationID.x; u < p.n_blocks_per_row * 16u; u += WG) {
        uint b = u >> 4, v = u & 15u, n = v >> 3, j = (v >> 1) & 3u, g = v & 1u;
        uint blk = base + b * 110u;
        float dl = f16_at(blk + 108u) * q3_k_scale(blk + 96u, v);
        uint qs = blk + 32u + n * 32u + g * 16u;
        uint hm = blk + g * 16u;
        uint xb = b * 256u + n * 128u + j * 32u + g * 16u;
        uint shift = 2u * j, hbit = n * 4u + j;
        float s = 0.0;
        for (uint l = 0u; l < 16u; ++l) {
            int raw = int((byte_at(qs + l) >> shift) & 3u);
            int bias = ((byte_at(hm + l) >> hbit) & 1u) != 0u ? 0 : 4;
            s += float(raw - bias) * x[xb + l];
        }
        acc += dl * s;
    }
    finish(row, acc);
}
